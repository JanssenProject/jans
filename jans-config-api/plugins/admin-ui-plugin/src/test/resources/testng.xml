<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >

<suite name="Config-API" parallel="false">

    <parameter name="propertiesFile" value="target/test-classes/test.properties" />
	
    <listeners>
        <listener class-name="io.jans.configapi.core.test.listener.AlterSuiteListener" />
        <listener class-name="io.jans.configapi.core.test.listener.SkipTestsListener" />
    </listeners>

    <test name="PolicyMapper" enabled="true">
        <classes>
            <class name="io.jans.ca.plugin.adminui.test.security.PolicyToScopeMapperTest" />
        </classes>
    </test>

    <test name="Services" enabled="true">
        <classes>
            <class name="io.jans.ca.plugin.adminui.test.services.AdminUISecurityServiceTest" />
            <class name="io.jans.ca.plugin.adminui.test.services.AdminUIServiceTest" />
            <class name="io.jans.ca.plugin.adminui.test.services.WebhookServiceTest" />
        </classes>
    </test>
	
	<test name="OAuth2" enabled="true">
        <classes>
             <class name="io.jans.ca.plugin.adminui.test.OAuth2ResourceTest" />
        </classes>
    </test>

  
    <test name="Logging" enabled="true">
        <classes>
             <class name="io.jans.ca.plugin.adminui.test.AuditLoggingResourceTest" />
             <class name="io.jans.ca.plugin.adminui.test.AuditLoggerResourceUnitTest" />
        </classes>
    </test>
	
	<test name="License" enabled="true">
        <classes>
             <class name="io.jans.ca.plugin.adminui.test.LicenseResourceTest" />
        </classes>
    </test>
</suite>
