{
  "name": "cedarling-example-electron",
  "description": "Electron desktop example using Cedarling authorization in the renderer and main process",
  "keywords": [
    "cedarling",
    "electron",
    "react",
    "authorization",
    "webassembly"
  ],
  "homepage": "https://github.com/JanssenProject/jans/tree/main/demos/cedarling-js-examples/electron",
  "bugs": {
    "url": "https://github.com/JanssenProject/jans/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanssenProject/jans.git",
    "directory": "demos/cedarling-js-examples/electron"
  },
  "license": "Apache-2.0",
  "author": "Janssen Project",
  "main": "./out/main/index.js",
  "scripts": {
    "install:sdk:local": "node ../scripts/install-example.mjs .",
    "build": "npm run typecheck && electron-vite build",
    "dev": "electron-vite dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "electron-vite preview",
    "start:docker": "node scripts/start-with-docker.mjs",
    "test": "jest",
    "test:build": "npm run build && node scripts/verify-build.mjs",
    "test:docker-workflow": "node --test scripts/docker-workflow.test.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
  "browserslist": [
    "Electron >= 35"
  ],
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.css$": "identity-obj-proxy"
    },
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "watchman": false,
    "testPathIgnorePatterns": [
      "/out/"
    ],
    "transform": {
      "\\.(ts|tsx|js|jsx)$": "ts-jest"
    }
  },
  "dependencies": {
    "@janssenproject/cedarling": "1.0.0",
    "jose": "^6.2.4",
    "openid-client": "^6.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "22.13.10",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.3.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.15",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10",
      "onFail": "error"
    }
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "version": "1.0.0",
  "private": true
}
