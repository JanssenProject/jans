{
  "name": "cedarling-example-electron",
  "description": "Electron desktop example using Cedarling authorization in the renderer and main process",
  "keywords": [
    "cedarling",
    "electron",
    "react",
    "authorization",
    "webassembly"
  ],
  "homepage": "https://github.com/JanssenProject/jans/tree/main/demos/cedarling-js-examples/electron",
  "bugs": {
    "url": "https://github.com/JanssenProject/jans/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanssenProject/jans.git",
    "directory": "demos/cedarling-js-examples/electron"
  },
  "license": "Apache-2.0",
  "author": "Janssen Project",
  "main": "./.erb/dll/main.bundle.dev.js",
  "scripts": {
    "install:sdk:local": "node ../scripts/install-example.mjs .",
    "build": "concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:main": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings\" webpack --config ./.erb/configs/webpack.config.main.prod.ts",
    "build:renderer": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings\" webpack --config ./.erb/configs/webpack.config.renderer.prod.ts",
    "build:renderer:dev": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings\" webpack --config ./.erb/configs/webpack.config.renderer.dev.ts",
    "lint": "cross-env NODE_ENV=development eslint .",
    "lint:fix": "cross-env NODE_ENV=development eslint . --fix",
    "start": "ts-node ./.erb/scripts/check-port-in-use.js && npm run start:renderer",
    "start:main": "concurrently -k -P \"cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --watch --config ./.erb/configs/webpack.config.main.dev.ts\" \"electronmon . --no-sandbox\"",
    "start:renderer": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings\" webpack serve --config ./.erb/configs/webpack.config.renderer.dev.ts",
    "test": "jest",
    "test:renderer-bundle": "npm run build:renderer && node scripts/verify-renderer-bundle.mjs",
    "test:renderer-dev-bundle": "npm run build:renderer:dev && node scripts/verify-renderer-dev-bundle.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
  "browserslist": [
    "Electron >= 35"
  ],
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.css$": "identity-obj-proxy"
    },
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "testPathIgnorePatterns": [
      ".erb/dll"
    ],
    "transform": {
      "\\.(ts|tsx|js|jsx)$": "ts-jest"
    }
  },
  "dependencies": {
    "@janssenproject/cedarling": "1.0.0",
    "jose": "^6.2.4",
    "openid-client": "^6.8.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "22.13.10",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "chalk": "^4.1.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "detect-port": "^2.1.0",
    "electron": "40.10.2",
    "electronmon": "^2.0.3",
    "eslint": "^10.8.0",
    "globals": "^17.6.0",
    "html-webpack-plugin": "^5.6.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss-loader": "^8.2.1",
    "postcss": "^8.5.23",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "ts-jest": "^29.2.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.8.2",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.65.0",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.15",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10",
      "onFail": "error"
    }
  },
  "electronmon": {
    "patterns": [
      "!**/**",
      "src/main/**",
      ".erb/dll/**"
    ],
    "logLevel": "quiet"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "version": "1.0.0",
  "private": true
}
