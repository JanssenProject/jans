{
  "name": "@janssenproject/cedarling",
  "version": "0.0.0-nightly",
  "description": "Fast, local Cedar policy authorization SDK for JavaScript, TypeScript, Node.js, browsers, and edge runtimes.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "authorization",
    "authz",
    "cedar",
    "cedar-policy",
    "policy-as-code",
    "access-control",
    "policy-decision-point",
    "oauth2",
    "openid-connect",
    "oidc",
    "jwt",
    "javascript",
    "typescript",
    "edge-runtime",
    "cedarling",
    "janssen"
  ],
  "homepage": "https://docs.jans.io/stable/cedarling/",
  "bugs": {
    "url": "https://github.com/JanssenProject/jans/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanssenProject/jans.git",
    "directory": "jans-cedarling/bindings/cedarling_js"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": { "node": ">=22 <23 || >=24 <25 || >=26 <27" },
  "types": "./dist/types/esm/index.d.ts",
  "files": [
    "dist/browser/index.js",
    "dist/browser/index.js.map",
    "dist/esm/index.js",
    "dist/esm/index.js.map",
    "dist/cjs/index.cjs",
    "dist/cjs/index.cjs.map",
    "dist/edge/index.js",
    "dist/edge/index.js.map",
    "dist/types/esm/**/*.d.ts",
    "dist/types/cjs/**/*.d.ts",
    "dist/types/cjs/package.json",
    "dist/wasm/cedarling_wasm_bg.wasm"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/types/esm/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "node": {
        "import": {
          "types": "./dist/types/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/types/cjs/index.d.ts",
          "default": "./dist/cjs/index.cjs"
        }
      },
      "import": {
        "types": "./dist/types/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/cjs/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      },
      "default": "./dist/browser/index.js"
    },
    "./edge": {
      "types": "./dist/types/esm/index.d.ts",
      "import": "./dist/edge/index.js",
      "default": "./dist/edge/index.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs build",
    "clean:tests": "node scripts/clean.mjs tests",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:compile": "npm run clean:tests && tsc -p tests/tsconfig.json",
    "test:prepare": "npm run build && npm run test:compile",
    "test:unit:run": "node .build/tests/runners/node.js unit",
    "test:unit": "npm run test:prepare && npm run test:unit:run",
    "test:contract:run": "node .build/tests/runners/node.js contract",
    "test:contract": "npm run test:prepare && npm run test:contract:run",
    "test:portable:bun:run": "bun run .build/tests/runners/node.js portable",
    "test:portable:bun": "npm run test:prepare && npm run test:portable:bun:run",
    "test:portable:deno:run": "deno run --allow-env --allow-read=dist/wasm/cedarling_wasm_bg.wasm .build/tests/runners/node.js portable",
    "test:portable:deno": "npm run test:prepare && npm run test:portable:deno:run",
    "test:browser:build": "esbuild .build/tests/runners/browser.js --bundle --platform=browser --format=esm --target=esnext --outfile=.build/browser/run-browser.js",
    "test:browser:run": "playwright test --config=tests/playwright.config.ts",
    "test:browser:firefox-esr:run": "node tests/runners/firefox-esr.mjs",
    "test:browser:firefox-esr": "npm run test:prepare && npm run test:browser:build && npm run test:browser:firefox-esr:run",
    "test:browser": "npm run test:prepare && npm run test:browser:build && npm run test:browser:run",
    "package:stage": "npm run build && node scripts/stage-packages.mjs",
    "package:verify": "npm run build && node scripts/verify-consumer.mjs",
    "check": "npm run typecheck && npm run test:prepare && npm run test:unit:run && npm run test:contract:run && node scripts/verify-consumer.mjs",
    "check:all": "npm run check && npm run test:portable:bun:run && npm run test:portable:deno:run && npm run test:browser:build && npm run test:browser:run && npm run test:browser:firefox-esr:run"
  },
  "devDependencies": {
    "@janssenproject/cedarling_wasm": "file:../cedarling_wasm/pkg",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/qunit": "2.19.14",
    "esbuild": "0.28.2",
    "qunit": "2.26.0",
    "typescript": "7.0.2"
  }
}
