{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "ESNext.Disposable"
    ],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "noEmitOnError": true,
    "rootDir": "src"
  },
  "include": [
    "src/index.ts",
    "src/node.ts",
    "src/edge.ts",
    "src/client.ts",
    "src/runtime.ts",
    "src/types.ts",
    "src/wasm-modules.d.ts"
  ]
}
