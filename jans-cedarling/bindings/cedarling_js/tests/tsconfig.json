{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "noEmit": false,
    "outDir": "../.build",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "rootDir": "..",
    "sourceMap": false,
    "types": [
      "node",
      "qunit"
    ]
  },
  "include": [
    "run.ts",
    "runners/**/*.ts",
    "fixtures/tracer-policy-store.ts",
    "unit/raw-wrapper.test.ts",
    "contract/raw-wrapper.test.ts",
    "contract/index.ts",
    "contract/portable.ts",
    "unit/index.ts"
  ]
}
