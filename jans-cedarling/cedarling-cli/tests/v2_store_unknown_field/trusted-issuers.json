{
    "Acme::Access_token": {
        "type": "jwt",
        "issuer": "Acme",
        "configuration_endpoints": {
            "jwks": "https://idp.acme.com/keys",
            "iss": "https://idp.acme.com"
        },
        "required_claim": ["sub"],
        "x_vendor": { "enabled": true }
    }
}
